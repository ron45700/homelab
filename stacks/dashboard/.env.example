# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored and should never be committed.

# 64-character hex string. Generate once and never change it:
#   openssl rand -hex 32
# PowerShell alternative:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
SECRET_ENCRYPTION_KEY=

# --- Tailscale ("dashboard" machine) ---
# Leave empty when ./appdata/tailscale already holds the machine's state
# (e.g. copied from the old streameron setup) - it stays logged in.
# For a brand new machine: admin console -> Settings -> Keys -> Generate auth
# key (not reusable, not ephemeral), use it once, then it can be cleared.
TS_AUTHKEY=

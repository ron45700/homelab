# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored and should never be committed.
# Everything here is optional: with an empty .env the site runs, with email and
# Telegram off.

FETCH_INTERVAL_MINUTES=60

# --- Email alerts to subscribers ---
# Global switch. While false, alerts wait in the queue and are sent once it is turned on.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# A Gmail App Password, not the regular account password.
SMTP_PASSWORD=

# --- Telegram alerts to the operator (a venue site broke / works again) ---
# The same bot and chat can later be used for Uptime Kuma's notifications.
# Token: from @BotFather. Chat id: send the bot a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and take message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Failed hourly runs in a row before a source is reported as broken.
SOURCE_ALERT_AFTER_FAILURES=3

# --- Admin panel (/#/admin): list and delete registered users ---
# Empty password = panel off. Use a long random password: it is the only protection.
# Five wrong attempts lock the client out for five minutes.
ADMIN_PASSWORD=
# Optional: show the "ניהול" menu entry only when signed in with this email.
ADMIN_EMAIL=

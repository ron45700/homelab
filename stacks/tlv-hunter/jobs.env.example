# Copy this file to jobs.env (same folder), fill in the values, then: chmod 600 jobs.env
# jobs.env is git-ignored (this folder's .gitignore) and is read by the `jobs` service only.
# Every command that uses these is PAID; each run needs Ron's go.

# Apify (collection: run_once). Read only by run_once.
APIFY_TOKEN=
# OpenAI (classification: classify_pending, regression_run, reclassify --run).
OPENAI_API_KEY=

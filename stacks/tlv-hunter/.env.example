# Copy this file to .env (same folder) and fill in the value.
# .env is git-ignored and should never be committed. It holds only the compose variable below;
# the job keys are in jobs.env (the site's container gets neither).

# --- Tailscale ("tlvapthunter" machine) ---
# For the first start only: admin console -> Settings -> Keys -> Generate auth key
# (not reusable, not ephemeral, no tags). Once ./appdata/tailscale holds the machine's state,
# clear it: the machine stays logged in (TS_AUTH_ONCE).
TS_AUTHKEY=

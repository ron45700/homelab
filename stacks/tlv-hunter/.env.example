# Copy this file to .env (same folder) and fill in the values.
# .env is git-ignored and should never be committed. It holds the compose variables below; the job
# keys are in jobs.env. Each variable reaches only the service named next to it (the site gets none).

# --- Tailscale ("tlvapthunter" machine) ---
# For the first start only: admin console -> Settings -> Keys -> Generate auth key
# (not reusable, not ephemeral, no tags). Once ./appdata/tailscale holds the machine's state,
# clear it: the machine stays logged in (TS_AUTH_ONCE).
TS_AUTHKEY=

# --- The Telegram bot (the `bot` service only) ---
# @tlv_apartment_hunter_bot's token, from BotFather. Never logged or printed by the bot.
TELEGRAM_BOT_TOKEN=
# The site's own address, which the alerts' buttons open: https://tlvapthunter.<tailnet>.ts.net
SITE_URL=

# --- The scheduler (the `scheduler` service only; read at its start) ---
# Minutes between two slots (5 to 1440), and the quiet hours in Israel time (HH:MM): no slot
# starts from QUIET_FROM until QUIET_UNTIL. Empty: 30, 00:00 and 07:00.
RUN_INTERVAL_MINUTES=
QUIET_FROM=
QUIET_UNTIL=
